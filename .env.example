# Discord bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID ช่องที่ให้บอทรับรูป (คั่นด้วย , ได้หลายช่อง) เว้นว่าง = ทุกช่อง
CHANNEL_IDS=1565192834615869481
# พอร์ตของ dashboard
PORT=3000
# รหัสผ่านเข้า dashboard (เว้นว่าง = ไม่ใช้รหัส) user ใช้ชื่ออะไรก็ได้
DASHBOARD_PASSWORD=
# เขตเวลาที่ใช้นับเดือน/วัน
TIMEZONE=Asia/Bangkok
# true = บอทเก็บรูปจากทุกข้อความในช่องอัตโนมัติ (ต้องเปิด Message Content Intent)
# ค่าเริ่มต้น false = รับรูปผ่านคำสั่ง /senreport เท่านั้น
AUTO_CAPTURE=false

# Supabase: เก็บรูปและข้อมูลรายงาน (Project Settings > API Keys)
SUPABASE_URL=https://tsidmncsifpmmyqprghh.supabase.co
# service_role / secret key ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามแชร์หรือใส่ในหน้าเว็บ
SUPABASE_SERVICE_KEY=
# publishable key ใช้ในหน้าเว็บเพื่อรับแจ้งเตือนรูปใหม่แบบ realtime (แชร์ได้)
SUPABASE_PUBLISHABLE_KEY=

# URL ของ dashboard ที่คนอื่นเปิดได้ (เช่น https://xxx.vercel.app) ใช้สร้างลิงก์รูปถาวรใน Discord/Excel
PUBLIC_URL=
